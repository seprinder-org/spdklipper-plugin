# SPDKlipper Plugin - Environment Configuration
# ===============================================
# Copy this file to .env and fill in your values.
# IMPORTANT: Keep your .env file secure! On Raspberry Pi, run:
#   chmod 600 .env
# to restrict access to the owner only.
#
# For extra security, use scripts/secure_env.sh to encrypt this file.

# --- Required Settings ---

# SPD Connect server URL (WebSocket/Socket.IO endpoint)
# This is the cloud server that relays print jobs to your printer.
HOST_CONNECT=https://connect.name.com

# SPD API server URL (REST API endpoint)
# This is the backend server for authentication, profiles, etc.
HOST_SERVER=https://api.{name}.com

# --- Security Settings ---

# SPD_SECRET_KEY is the master encryption key for all stored secrets
# (access tokens, refresh tokens, user credentials).
#
# SECURITY BEST PRACTICES:
# 1. GENERATE a strong random key (recommended 32+ characters):
#      python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 2. If LEFT EMPTY, the system will auto-generate a key on first run
#    and store it securely in the database (recommended for Raspberry Pi).
# 3. If SET HERE, this key will be used as the master key. Keep it secret!
# 4. On Raspberry Pi, protect this file:
#      chmod 600 .env
SPD_SECRET_KEY=

# --- Database Settings ---

# Path to the SQLite database file (relative to project root)
# This stores encrypted secrets, logs, and socket status.
# The database file will be created automatically on first run.
PATH_DB=database.sqlite3

# --- Optional Settings ---

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Camera snapshot URL template (if different from stream URL)
# CAMERA_SNAPSHOT_URL=

# ===============================================
# AUTO-LOGIN CONFIGURATION (spdklipper.conf)
# ===============================================
# Instead of using the web interface at http://localhost:1122,
# you can set up auto-login by editing the spdklipper.conf file
# (located in your Klipper config directory, e.g. ~/printer_data/config/).
#
# Add the following section to spdklipper.conf:
#
#   [credentials]
#   username: your_email_or_username
#   password: your_password
#
# The plugin will then:
#   1. Automatically log in on startup
#   2. Fetch your list of machines from seprinder.com
#   3. Auto-select the correct machine (or the first one)
#   4. Connect to the socket server
#
# No need to specify Machine ID — the plugin detects it automatically!
# To switch machines, just change the machine assignment on seprinder.com.
