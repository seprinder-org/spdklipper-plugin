# SPD Bridge - Raspberry Pi (ARM64) Production Image
# Runs source code directly via uvicorn (no PyInstaller)

FROM arm64v8/debian:bookworm-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends --fix-missing \
    python3 python3-pip python3-venv \
    libffi-dev libssl-dev libjpeg-dev zlib1g-dev libopenblas-dev \
    curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

# Install Python dependencies
RUN pip3 install --upgrade pip --break-system-packages && \
    pip3 install -r scripts/requirements.txt --break-system-packages

# Expose port
EXPOSE 1122

# Run directly with uvicorn
CMD ["python3", "plugin/main.py"]
