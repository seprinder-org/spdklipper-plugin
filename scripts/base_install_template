[server]
# SPD server configuration.
# If these are set, the plugin will connect to custom servers instead of
# the default production servers (seprinder.com).
#
# --- host_server ---
# The SPD backend API server URL (default: http://localhost:3000)
# Example: https://seprinder.com
# host_server: http://localhost:3000
#
# --- host_connect ---
# The SPD WebSocket / Connect server URL (default: http://localhost:3030)
# Example: wss://connect.seprinder.com
# host_connect: http://localhost:3030

[credentials]
# SPD account credentials for auto-login.
# If these are set, the plugin will automatically log in on startup
# without requiring the web interface at localhost:1122.
#
# All 3 fields are REQUIRED for auto-login to work.
#
# --- username ---
# Your SPD account email or username.
username:

# --- password ---
# Your SPD account password.
password:

# --- machine_id ---
# The "Identify Number" of the printer you want to use.
# To find your Machine ID:
#   1. Log in to https://seprinder.com
#   2. Go to your profile -> Machines section
#   3. Copy the "Identify Number" of your printer
machine_id:
